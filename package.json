{
    "name": "dsh-provider-copilot",
    "version": "0.0.1",
    "description": "Bridge a GitHub Copilot subscription into DeepSeek Harness (dsh) as an LLM provider.",
    "keywords": [
        "dsh",
        "deepseek-harness",
        "llm",
        "provider",
        "github-copilot",
        "copilot"
    ],
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20.10.0"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "cordis.patch.yml"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
        "poc": "tsx scripts/poc.ts",
        "prepublishOnly": "npm run typecheck && npm run test && npm run build"
    },
    "files": [
        "dist/**/*",
        ".pi/**/*",
        "cordis.patch.yml",
        "docs/*.png",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "9.17.0",
        "@types/node": "20.17.10",
        "eslint": "9.17.0",
        "tsx": "4.19.2",
        "typescript": "5.7.2",
        "typescript-eslint": "8.19.0",
        "vitest": "2.1.8"
    }
}
