{
    "name": "dsh-provider-copilot",
    "version": "0.0.1",
    "description": "Bridge GitHub Copilot subscription to DeepSeek Harness as an LLM provider",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20.10.0"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
        "poc": "tsx scripts/poc.ts"
    },
    "files": [
        "dist/**/*",
        ".pi/**/*",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {},
    "devDependencies": {
        "@types/node": "20.17.10",
        "eslint": "9.17.0",
        "tsx": "4.19.2",
        "typescript": "5.7.2",
        "vitest": "4.1.0"
    }
}
